function importarImovel() {
  if(!confirm('Adicionar custos do imóvel?')) return;
  const custos=[
    {id:Date.now()+100,descricao:'Entrada Imobiliária',categoria:'Imóvel — Entrada/Sinal',valor:45000,data:'2026-08-13',status:'pago'},
    {id:Date.now()+101,descricao:'Certidão Imóvel CNP (mãe pagou)',categoria:'Imóvel — Documentação',valor:43,data:'2026-08-13',status:'pago'},
    {id:Date.now()+102,descricao:'Entrada Carta Maior (mãe pagou)',categoria:'Imóvel — Entrada/Sinal',valor:200057.64,data:'2026-08-13',status:'pago'},
    {id:Date.now()+103,descricao:'Taxa Transf. Carta Maior (mãe pagou)',categoria:'Imóvel — Documentação',valor:3062.11,data:'2026-08-13',status:'pago'},
    {id:Date.now()+104,descricao:'Entrada Carta Menor',categoria:'Imóvel — Entrada/Sinal',valor:150975.10,data:'2026-08-13',status:'pago'},
    {id:Date.now()+105,descricao:'Taxa Transf. Carta Menor',categoria:'Imóvel — Documentação',valor:2314.61,data:'2026-08-13',status:'pago'},
    {id:Date.now()+106,descricao:'Matrícula Apto Batel',categoria:'Imóvel — Documentação',valor:73.28,data:'2026-08-13',status:'pago'},
    {id:Date.now()+107,descricao:'2ª Via Escritura',categoria:'Imóvel — Documentação',valor:26.77,data:'2026-08-13',status:'pago'},
    {id:Date.now()+108,descricao:'Certidão Casamento Atualizada',categoria:'Imóvel — Documentação',valor:388.90,data:'2026-08-13',status:'pago'},
  ].map(c=>({...c,adicionadoPor:currentUser,adicionadoEm:new Date().toISOString()}));
  data.fixedExpenses.push(...custos);
  saveData(); renderAll();
  showToast(`✅ ${custos.length} lançamentos do imóvel importados!`);
}
